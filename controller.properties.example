# =====================================================================
# Configuración del Auto-Scaling Controller
# Aquí NO van credenciales: el SDK las toma del rol de la instancia
# (LabInstanceProfile) o de ~/.aws/credentials en pruebas locales.
# =====================================================================

# --- AWS: reemplazar con los valores reales de tu infraestructura ---
aws.region=us-east-1
aws.launchTemplateId=lt-... (ID del launch template)
aws.targetGroupArn=arn:aws:elasticloadbalancing... (ARN del target group)

# --- Controller ---
log.archivo=ciclos.csv
controller.intervaloSegundos=60
# ciclos sin actuar después de subir/bajar (~tiempo en que una instancia nueva queda lista)
controller.cooldownCiclos=5
# 10 lecturas anteriores + la actual
controller.tamanoVentana=11

# --- Política: límites absolutos (opcionales; si se borran se usan los valores por defecto) ---
politica.techoCpu=75
politica.pisoCpu=30
# Requests por instancia por minuto: CALIBRAR con una prueba de carga de la app
politica.techoRequest=540
politica.pisoRequest=300
